{
  "id": "dsh-flash-presets",
  "name": "DSH Flash 精简预设",
  "version": "0.2.0",
  "description": "Two DSH agent presets tuned for token efficiency on flash-tier routes: PTC tool surface plus hard behavior rules, with a tunable compaction threshold and a step budget.",
  "descriptionZh": "面向 flash 级路由的 token 效率优化 agent 预设（v1/v2）：PTC 工具面 + 硬约束，压缩阈值与步数预算可调；以 dsh.bundle 组合包形式一键安装，含 8 用例基准数据与端到端自测。",
  "author": {
    "name": "LarryE135",
    "url": "https://github.com/LarryE135"
  },
  "license": "MIT",
  "category": "workflow",
  "tags": [
    "preset",
    "agent-preset",
    "token-efficiency",
    "flash",
    "ptc",
    "compaction"
  ],
  "compatibility": {
    "dsh": ">=0.1.7-rc.1",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ]
  },
  "install": {
    "target": "git",
    "spec": "github:LarryE135/dsh-flash-presets",
    "command": "dsh plugin --profile {profile} add github:LarryE135/dsh-flash-presets"
  },
  "verified": false,
  "maintainers": [
    "LarryE135"
  ],
  "repository": "https://github.com/LarryE135/dsh-flash-presets",
  "docs": "https://github.com/LarryE135/dsh-flash-presets#readme"
}
