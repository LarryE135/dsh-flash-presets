{
  "id": "dsh-flash-presets",
  "name": "DSH Flash 精简预设",
  "version": "0.2.9",
  "description": "Two DSH agent presets tuned for token efficiency on flash-tier routes: PTC tool surface, a 25% compaction threshold and a turn budget. lite keeps 13 rules (default); balance keeps only the 3 rules the harness cannot enforce.",
  "descriptionZh": "面向 flash 级路由的 token 效率预设，只发两个：lite（13 条规则，默认）与 balance（3 条规则）。旧 id 由运行时兼容层解析到 lite，不改写任何会话文件。",
  "author": {
    "name": "LarryE135",
    "url": "https://github.com/LarryE135"
  },
  "license": "MIT",
  "category": "workflow",
  "tags": [
    "preset",
    "agent-preset",
    "token-efficiency",
    "flash",
    "ptc",
    "compaction",
    "lean"
  ],
  "compatibility": {
    "dsh": ">=0.2.1-rc.5 <0.2.3-0",
    "node": ">=22.15",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ]
  },
  "install": {
    "target": "npm",
    "spec": "dsh-flash-presets@0.2.9",
    "command": "dsh plugin --profile {profile} add dsh-flash-presets@0.2.9",
    "git": "dsh plugin --profile {profile} add github:LarryE135/dsh-flash-presets#v0.2.9"
  },
  "verified": false,
  "maintainers": [
    "LarryE135"
  ],
  "repository": "https://github.com/LarryE135/dsh-flash-presets",
  "docs": "https://github.com/LarryE135/dsh-flash-presets#readme"
}
