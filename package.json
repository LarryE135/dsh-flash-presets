{
  "name": "dsh-flash-presets",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "DSH Flash 精简预设：两个 agent 预设（精简·PTC v3（lean-v3），flash-lean-ptc-v3，13 条规则，默认；精简·PTC v3 balance，flash-lean-ptc-v3-balance，3 条规则），以 DSH 组合包（dsh.bundle）形式安装到 profile，并附带计划模式组件（plan-mode v1）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "preset",
    "flash",
    "token-efficiency"
  ],
  "author": "LarryE135 (https://github.com/LarryE135)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LarryE135/dsh-flash-presets.git"
  },
  "homepage": "https://github.com/LarryE135/dsh-flash-presets",
  "bugs": {
    "url": "https://github.com/LarryE135/dsh-flash-presets/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.2.3-0",
    "node": ">=22.15"
  },
  "scripts": {
    "build": "node scripts/compose-bundle-patch.mjs",
    "check": "node scripts/compose-bundle-patch.mjs --check",
    "verify": "node scripts/sync-lib.mjs --check && node scripts/verify-yaml.mjs && node scripts/verify-presets.mjs --repo-only && node scripts/lint-presets.mjs && node scripts/guard-bench-leak.mjs && node scripts/verify-versions.mjs && node scripts/check-preset-compat.mjs && node scripts/render-bench-table.mjs --check && node scripts/check-bash32-cjk.mjs && node scripts/check-ps1.mjs",
    "verify:versions": "node scripts/verify-versions.mjs",
    "ab:run": "bash scripts/ab-run.sh",
    "ab:overlay": "node scripts/ab-overlay.mjs",
    "verify:bench-table": "node scripts/render-bench-table.mjs --check",
    "render:bench-table": "node scripts/render-bench-table.mjs --write",
    "prepublishOnly": "node scripts/sync-lib.mjs --check && node scripts/compose-bundle-patch.mjs --check && node scripts/verify-yaml.mjs && node scripts/verify-presets.mjs --repo-only && node scripts/check-preset-compat.mjs && node scripts/lint-presets.mjs && node scripts/guard-bench-leak.mjs && node scripts/bench-release-checklist.mjs && node scripts/verify-release-hygiene.mjs && node scripts/verify-versions.mjs && node scripts/render-bench-table.mjs --check && bash scripts/selftest.sh",
    "lint": "node scripts/lint-presets.mjs",
    "guard:bench": "node scripts/guard-bench-leak.mjs",
    "bench:office": "node benchmarks/office/tools/check.mjs",
    "checklist:bench": "node scripts/bench-release-checklist.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:compat": "node scripts/check-preset-compat.mjs",
    "audit:sessions": "node scripts/audit-compat.mjs",
    "audit:align": "node scripts/audit-align.mjs",
    "retarget:sessions": "node scripts/retarget-session-presets.mjs",
    "verify:release": "node scripts/verify-release-hygiene.mjs",
    "pack:plugin": "node scripts/pack-plugin.mjs",
    "prepack": "node scripts/sync-lib.mjs && node scripts/compose-bundle-patch.mjs",
    "verify:alias": "node tools/probe/alias-vs-config.mjs --composed"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "presets/flash-lean-ptc-v3.patch.yml",
    "presets/flash-lean-ptc-v3-balance.patch.yml",
    "presets/legacy-preset-map.json",
    "presets/compat-exceptions.json",
    ".gitattributes",
    "NOTICE",
    "scripts/lib/",
    "scripts/install.sh",
    "scripts/install.ps1",
    "scripts/merge-presets.mjs",
    "scripts/platform-tags.mjs",
    "scripts/verify-yaml.mjs",
    "scripts/verify-presets.mjs",
    "scripts/verify-runtime.mjs",
    "scripts/check-preset-compat.mjs",
    "scripts/compose-bundle-patch.mjs",
    "scripts/doctor.mjs",
    "scripts/tune-runtime.mjs",
    "scripts/diag-preset-load.mjs",
    "scripts/audit-align.mjs",
    "scripts/audit-compat.mjs",
    "docs/CHANGELOG.md",
    "docs/版本与兼容性.md",
    "docs/技术文档-省token四机制.md",
    "docs/技术文档-精简预设实现.md",
    "docs/实测证据.md",
    "docs/预设-id-契约与升级.md",
    "docs/审计索引-0.2.9.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./alias": {
      "default": "./lib/alias-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.2.3-0 || >=0.2.2-0 <0.2.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "publishedVersion": "0.3.0"
}
