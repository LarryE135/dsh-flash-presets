{
  "name": "dsh-flash-presets",
  "version": "0.2.5",
  "private": false,
  "description": "DSH Flash 精简预设（v1/v2/v3）：面向 flash 级路由做 token 效率优化的 agent 预设，以 DSH 组合包（dsh.bundle）形式一键安装到 profile。v3（lean-v3）为现行主版本。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "preset",
    "flash",
    "token-efficiency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LarryE135/dsh-flash-presets.git"
  },
  "homepage": "https://github.com/LarryE135/dsh-flash-presets",
  "bugs": {
    "url": "https://github.com/LarryE135/dsh-flash-presets/issues"
  },
  "scripts": {
    "build": "node scripts/compose-bundle-patch.mjs",
    "check": "node scripts/compose-bundle-patch.mjs --check",
    "verify": "node scripts/verify-yaml.mjs && node scripts/verify-presets.mjs --repo-only && node scripts/lint-presets.mjs && node scripts/guard-bench-leak.mjs",
    "prepublishOnly": "node scripts/compose-bundle-patch.mjs --check && node scripts/verify-yaml.mjs && node scripts/verify-presets.mjs --repo-only && node scripts/lint-presets.mjs && node scripts/guard-bench-leak.mjs && node scripts/bench-release-checklist.mjs && node scripts/verify-release-hygiene.mjs && bash scripts/selftest.sh",
    "lint": "node scripts/lint-presets.mjs",
    "guard:bench": "node scripts/guard-bench-leak.mjs",
    "bench:office": "node benchmarks/office/tools/check.mjs",
    "checklist:bench": "node scripts/bench-release-checklist.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:release": "node scripts/verify-release-hygiene.mjs"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "presets/flash-lean-ptc-v1.patch.yml",
    "presets/flash-lean-ptc-v2.patch.yml",
    "presets/flash-lean-ptc-v3.patch.yml",
    "presets/legacy-0.1.5/",
    ".gitattributes",
    "scripts/",
    "!scripts/publish.sh",
    "!scripts/publish.ps1",
    "!scripts/npm-downloads-badge.mjs",
    "!scripts/lint-allowlist.json",
    "docs/CHANGELOG.md",
    "docs/版本与兼容性.md",
    "docs/技术文档-省token四机制.md",
    "docs/技术文档-精简预设实现.md",
    "docs/实测证据.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "publishedVersion": "0.2.5",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  }
}
