{
  "name": "fl-bash",
  "version": "0.1.6",
  "description": "fl-bash for DeepSeek Harness: an optional Bash-compatible shell tool (fl_bash) for Windows x64 hosts, backed by a bundled single-file Rust interpreter (flash-sh; no Git Bash / WSL / MSYS2). Off by default. Shows up as its own component, whether installed standalone or through dsh-flash-presets. Formerly dsh-flash-sh.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bash",
    "shell",
    "windows",
    "fl-bash"
  ],
  "license": "MIT",
  "author": "LarryE135 (https://github.com/LarryE135)",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "files": [
    "lib",
    "locale",
    "vendor",
    "scripts/check-flash-sh.ps1",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "THIRD_PARTY_LICENSE_TEXTS.txt"
  ],
  "engines": {
    "node": ">=22.15",
    "dsh": ">=0.2.1-rc.5 <0.2.3-0"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    }
  }
}
