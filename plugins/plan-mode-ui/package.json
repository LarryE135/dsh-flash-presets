{
  "name": "dsh-plan-mode-ui",
  "version": "0.4.3",
  "description": "Two-phase plan mode for DeepSeek Harness: a composer icon opens a panel (tier off/light/full, scope, Max mode); the host half intercepts the turn with a planning protocol, then resumes execution in the same turn and reports the measured acceptance numbers.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plan-mode",
    "planning",
    "two-phase",
    "web-ui",
    "client-plugin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
