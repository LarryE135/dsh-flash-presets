# Normalize to LF inside the repository, and check out shell/node sources as LF on every OS.
# Without this, a Windows clone with core.autocrlf=true turns install.sh into CRLF and
# bash then fails with: bad interpreter: /usr/bin/env bash^M
* text=auto eol=lf
*.sh    text eol=lf
*.mjs   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
# PowerShell 5.1/7 都能读 LF；仓库统一 LF，避免“声明 CRLF 实际 LF”的自欺（2026-10-24 审计）
*.ps1   text eol=lf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.png   binary
*.zip   binary
# plugins/ 只在仓库里做版本管理，不随 git archive 进 Release 包（预设包本身不需要它们）
plugins/ export-ignore
